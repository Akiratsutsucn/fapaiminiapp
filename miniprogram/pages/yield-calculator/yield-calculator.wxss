.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-page);
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.form-group { margin-bottom: 20rpx; }

.label {
  display: block;
  font-size: 24rpx;
  color: var(--blue-700);
  margin-bottom: 12rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background: var(--blue-50);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--blue-900);
  font-weight: 700;
  box-sizing: border-box;
  font-variant-numeric: tabular-nums;
}

.opt-group { display: flex; gap: 12rpx; }

.opt-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--blue-50);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--blue-700);
  font-weight: 600;
  border: 2rpx solid transparent;
}

.opt-chip.active {
  background: var(--blue-900);
  color: #fff;
  border-color: var(--blue-900);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(58, 90, 140, 0.3);
}

/* 分组小标题 */
.section-divider {
  margin: 32rpx 0 20rpx;
  display: flex;
  align-items: center;
}

.section-divider text {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--blue-900);
  letter-spacing: 2rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--accent-orange);
  line-height: 1;
}

.btn-row { margin-top: 24rpx; }

.btn-row .btn-primary {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
  background: linear-gradient(135deg, var(--accent-orange) 0%, var(--accent-orange-2) 100%);
  border-radius: var(--radius-pill);
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.btn-row .btn-primary::after { border: none; }

/* ===== 结果 ===== */
.result-card {
  padding: 0;
  overflow: hidden;
  position: relative;
}

.result-highlight {
  padding: 40rpx 28rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--blue-900) 0%, var(--blue-700) 100%);
  position: relative;
  overflow: hidden;
  color: #fff;
}

.result-highlight::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(201, 152, 70, 0.22) 0%, rgba(255, 107, 53, 0.1) 45%, transparent 72%);
  border-radius: 50%;
}

.result-label {
  display: block;
  font-size: 22rpx;
  color: var(--blue-200);
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.result-number {
  font-size: 80rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  position: relative;
  z-index: 1;
}

.result-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--blue-200);
  margin-left: 6rpx;
}

.result-sub {
  display: block;
  font-size: 24rpx;
  color: var(--blue-200);
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}

/* ===== 三阶段明细 ===== */
.stage { padding: 24rpx 28rpx 0; }

.stage-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 8rpx;
}

.stage-title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--blue-900);
  letter-spacing: 1rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--accent-gold);
  line-height: 1;
}

.stage-total {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--blue-700);
  font-variant-numeric: tabular-nums;
}

.fee-list { padding: 0 0 4rpx; }

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(58, 90, 140, 0.06);
}

.fee-k { font-size: 25rpx; color: var(--text-secondary); flex-shrink: 1; padding-right: 16rpx; }

.fee-note { font-size: 21rpx; color: var(--accent-gold-text); }

.fee-v {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--blue-900);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.fee-v.accent { color: var(--accent-orange-text); }

/* 汇总区 */
.summary { padding: 12rpx 28rpx 8rpx; }

.fee-row.total {
  border-bottom: none;
  border-top: 2rpx solid rgba(58, 90, 140, 0.1);
  margin-top: 4rpx;
  padding-top: 22rpx;
}

.fee-row.total .fee-k { font-weight: 700; color: var(--blue-900); }
.fee-row.total .fee-v { font-size: 34rpx; font-weight: 900; }

.disclaimer {
  padding: 16rpx 28rpx 8rpx;
  font-size: 20rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

.share-btn-row { padding: 16rpx 28rpx 28rpx; margin-top: 0; }

/* ===== 分享图弹窗 ===== */
.share-modal {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.share-panel {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-sizing: border-box;
  max-height: 90vh;
  overflow: hidden;
}

.share-img {
  width: 100%;
  border-radius: var(--radius-md);
  display: block;
}

.share-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.share-btn {
  flex: 1;
  height: 84rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.share-btn::after { border: none; }

.share-btn.save {
  background: linear-gradient(135deg, var(--accent-orange) 0%, var(--accent-orange-2) 100%);
  color: #fff;
}

.share-btn.forward {
  background: var(--blue-50);
  color: var(--blue-900);
}

.share-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 16rpx;
}

/* 离屏 canvas：移出可视区，不占用布局 */
.offscreen-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1180rpx;
}
