<view class="ai-search-page">
  <view class="as-header">
    <text class="as-title">选房</text>
    <text class="as-subtitle">输入关键词，快速找法拍房</text>
  </view>

  <!-- 输入区域 -->
  <view class="as-input-wrap">
    <textarea
      class="as-input"
      placeholder="输入小区名、区域或关键词，如：徐汇 住宅"
      value="{{query}}"
      bindinput="onQueryInput"
      maxlength="100"
      auto-height
    />
    <view class="as-actions">
      <button class="as-btn as-btn-search" bindtap="onSearch" loading="{{searching}}">搜索</button>
    </view>
  </view>

  <!-- 示例引导 -->
  <view class="as-examples" wx:if="{{!searched}}">
    <text class="as-examples-title">试试这样搜：</text>
    <view class="as-example-tags">
      <view class="as-tag" bindtap="onTapExample" data-text="浦东新区">浦东新区</view>
      <view class="as-tag" bindtap="onTapExample" data-text="徐汇 住宅">徐汇 住宅</view>
      <view class="as-tag" bindtap="onTapExample" data-text="静安">静安</view>
      <view class="as-tag" bindtap="onTapExample" data-text="宁波 江北">宁波 江北</view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="as-results" wx:if="{{searched}}">
    <view class="as-results-header">
      <text class="as-results-count">找到 {{total}} 套房源</text>
    </view>
    <view class="as-list" wx:if="{{list.length > 0}}">
      <house-card wx:for="{{list}}" wx:key="id" property="{{item}}" />
    </view>
    <view class="as-empty" wx:if="{{list.length === 0 && !searching}}">
      <text>暂无匹配房源，试试调整关键词</text>
    </view>
  </view>

  <!-- 联系方式门禁弹窗:使用选房前必须填写手机号+姓氏 -->
  <view class="contact-mask" wx:if="{{showContactModal}}" catchtouchmove="true">
    <view class="contact-modal">
      <view class="contact-title">填写联系方式</view>
      <view class="contact-tip">使用选房需先留下联系方式,方便顾问为您 1 对 1 服务</view>
      <view class="contact-field">
        <text class="contact-label">姓氏 <text class="contact-req">*</text></text>
        <input class="contact-input" placeholder="请输入您的姓氏(如:张)" maxlength="10" value="{{contactForm.surname}}" bindinput="onContactInput" data-field="surname" />
      </view>
      <view class="contact-field">
        <text class="contact-label">手机号 <text class="contact-req">*</text></text>
        <input class="contact-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{contactForm.phone}}" bindinput="onContactInput" data-field="phone" />
      </view>
      <view class="contact-btns">
        <button class="contact-btn contact-btn-cancel" bindtap="onCloseContactModal">取消</button>
        <button class="contact-btn contact-btn-ok" loading="{{savingContact}}" bindtap="onSubmitContact">确定</button>
      </view>
    </view>
  </view>
</view>
