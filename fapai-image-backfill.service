[Unit]
Description=法拍者联盟 图片治理(恢复logo误判+补阿里/京东在拍缺图)
After=network.target fapai-crawler-ali.timer

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/fapai
EnvironmentFile=/opt/fapai/.env
Environment=PYTHONPATH=/opt/fapai
ExecStart=/bin/bash -c 'for i in $(seq 1 60); do pgrep -f "crawler.main --source" >/dev/null || break; echo "日常爬虫运行中,等其结束(防抢SSR名额)..."; sleep 60; done; if pgrep -f "crawler.backfill_ali_images" >/dev/null; then echo "已有补图进程在跑,本次跳过"; exit 0; fi; exec flock -n /tmp/fapai-imgbackfill.lock /bin/bash -c "/opt/fapai/venv/bin/python -m crawler.recheck_hidden_images --commit; /opt/fapai/venv/bin/python -m crawler.backfill_ali_images --commit --platform 阿里拍卖; /opt/fapai/venv/bin/python -m crawler.backfill_ali_images --commit --platform 京东拍卖"'
TimeoutStartSec=10800
StandardOutput=append:/var/log/fapai/image-backfill.log
StandardError=append:/var/log/fapai/image-backfill.log
